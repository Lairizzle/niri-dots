// Window rules
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Kitty: background blur
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}

// Kitty: transparency when unfocused
window-rule {
    match app-id="^kitty$"
    match is-focused=false
    opacity 0.8
}

window-rule {
    match app-id="wiremix"
    open-floating true

    default-floating-position x=8 y=8 relative-to="top-right"
}

// Apps that open on DP-2
window-rule {
    match app-id="discord"
    open-on-output "DP-2"
}

window-rule {
    match app-id="brave-browser"
    open-on-output "DP-2"
    opacity 1.0
}

window-rule {
    match app-id="Spotify"
    open-on-output "DP-2"
}

// WezTerm: fix initial configure bug
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox picture-in-picture: open floating
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block password managers from screen capture (disabled)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

// Example: rounded corners for all windows (disabled)
/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
